<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <!-- The API references this project for its DbContext and entities. Keep the API's own settings
           as the only appsettings files in its publish directory. -->
      <Content Remove="appsettings*.json" Condition="'$(FirmezaApiReference)' == 'true'" />
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
      <PackageReference Include="EPPlus" Version="8.6.0" />
      <PackageReference Include="QuestPDF" Version="2026.9.1" />
      <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
      <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    </ItemGroup>

</Project>

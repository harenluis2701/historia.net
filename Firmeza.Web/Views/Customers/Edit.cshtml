@model Firmeza.Web.Models.Customer

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="container mt-4">
    <h2 class="mb-4 text-dark fw-bold">✏️ Editar Cliente</h2>

    <div class="card shadow border-0 rounded-3">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                
                <!-- ¡MUY IMPORTANTE! Campo oculto con el ID del cliente -->
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Document" class="form-label fw-semibold">Documento de Identidad</label>
                        <input asp-for="Document" class="form-control shadow-sm" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Nombre Completo</label>
                        <input asp-for="FullName" class="form-control shadow-sm" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Correo Electrónico</label>
                        <input asp-for="Email" type="email" class="form-control shadow-sm" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone" class="form-label fw-semibold">Teléfono</label>
                        <input asp-for="Phone" class="form-control shadow-sm" required />
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary me-2 shadow-sm">Cancelar</a>
                    <button type="submit" class="btn btn-primary shadow-sm">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>
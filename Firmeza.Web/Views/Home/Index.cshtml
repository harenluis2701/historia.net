@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4 text-dark fw-bold">Dashboard Principal</h2>

<div class="row">
    <!-- Tarjeta de Productos -->
    <div class="col-md-4 mb-4">
        <div class="card text-white bg-primary shadow border-0 rounded-3">
            <div class="card-body">
                <h5 class="card-title fw-semibold">📦 Total Productos</h5>
                <h2 class="display-4 fw-bold">@ViewBag.TotalProducts</h2>
                <a asp-controller="Products" asp-action="Index" class="text-white text-decoration-none small">Ver inventario ➔</a>
            </div>
        </div>
    </div>

    <!-- Tarjeta de Clientes -->
    <div class="col-md-4 mb-4">
        <div class="card text-white bg-success shadow border-0 rounded-3">
            <div class="card-body">
                <h5 class="card-title fw-semibold">👥 Total Clientes</h5>
                <h2 class="display-4 fw-bold">@ViewBag.TotalCustomers</h2>
                <a asp-controller="Customers" asp-action="Index" class="text-white text-decoration-none small">Ver clientes ➔</a>
            </div>
        </div>
    </div>

    <!-- Tarjeta de Ventas (Pendiente) -->
    <div class="col-md-4 mb-4">
        <div class="card text-white bg-warning shadow border-0 rounded-3">
            <div class="card-body">
                <h5 class="card-title fw-semibold">💰 Total Ventas</h5>
                <h2 class="display-4 fw-bold">@ViewBag.TotalSales</h2>
                <span class="text-white small">Módulo próximamente</span>
            </div>
        </div>
    </div>
</div>
@model Firmeza.Web.Services.ImportResult
@{ ViewData["Title"] = "Resultado de importación"; }
<h1>Resultado de importación</h1>
<div class="row g-3 my-2"><div class="col-md-4"><div class="card card-body">Productos creados/actualizados: <strong>@Model.Products</strong></div></div><div class="col-md-4"><div class="card card-body">Clientes creados/actualizados: <strong>@Model.Customers</strong></div></div><div class="col-md-4"><div class="card card-body">Ventas creadas: <strong>@Model.Sales</strong></div></div></div>
@if (Model.Issues.Count > 0) { <div class="d-flex justify-content-between align-items-center mt-4"><h2 class="h4">Filas con inconsistencias (@Model.Issues.Count)</h2><form asp-action="DownloadLog" method="post">@for (var i=0;i<Model.Issues.Count;i++){<input type="hidden" name="issues[@i].Sheet" value="@Model.Issues[i].Sheet"/><input type="hidden" name="issues[@i].Row" value="@Model.Issues[i].Row"/><input type="hidden" name="issues[@i].Message" value="@Model.Issues[i].Message"/>}<button class="btn btn-outline-danger">Descargar log CSV</button></form></div><div class="card"><table class="table mb-0"><thead><tr><th>Hoja</th><th>Fila</th><th>Inconsistencia</th></tr></thead><tbody>@foreach(var issue in Model.Issues){<tr><td>@issue.Sheet</td><td>@issue.Row</td><td>@issue.Message</td></tr>}</tbody></table></div> } else { <div class="alert alert-success">No se encontraron inconsistencias.</div> }
<a asp-action="Index" class="btn btn-primary mt-3">Importar otro archivo</a>

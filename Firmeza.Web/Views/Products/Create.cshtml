@model Firmeza.Web.Models.Product

@{
    ViewData["Title"] = "Crear Producto";
}

<h1 class="mb-4">Registrar Nuevo Producto</h1>

<div class="row">
    <div class="col-md-6">
        @* El Tag Helper asp-action="Create" le dice al formulario a qué método enviar los datos *@
        <form asp-action="Create" method="post">
            
            <div class="mb-3">
                @* asp-for enlaza automáticamente este campo con la propiedad Name de tu modelo *@
                <label asp-for="Name" class="form-label">Nombre del Producto</label>
                <input asp-for="Name" class="form-control" placeholder="Ej: Taladro" required />
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label">Precio</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="Ej: 15000" required />
            </div>
            
            <button type="submit" class="btn btn-success">Guardar Producto</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
@model Firmeza.Web.Models.Product
@{ ViewData["Title"] = "Editar producto"; }

<div class="page-heading">
    <div class="page-eyebrow">Inventario · Producto #@Model.Id</div>
    <h1>Editar producto</h1>
    <p>Actualiza los datos del producto y corrige sus existencias disponibles.</p>
</div>

<div class="card"><div class="card-body">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-md-7"><label asp-for="Name" class="form-label">Nombre del producto</label><input asp-for="Name" class="form-control" required /><span asp-validation-for="Name" class="text-danger small"></span></div>
            <div class="col-md-5"><label asp-for="Price" class="form-label">Precio unitario</label><input asp-for="Price" type="number" min="0.01" step="0.01" class="form-control" required /><span asp-validation-for="Price" class="text-danger small"></span></div>
            <div class="col-12"><label asp-for="Description" class="form-label">Descripción</label><textarea asp-for="Description" class="form-control"></textarea></div>
            <div class="col-md-5"><label asp-for="Stock" class="form-label">Existencias disponibles</label><input asp-for="Stock" type="number" min="0" step="1" class="form-control" required /><span asp-validation-for="Stock" class="text-danger small"></span></div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4"><button type="submit" class="btn btn-primary">Guardar cambios</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

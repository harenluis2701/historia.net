@model Firmeza.Web.Models.Product

@{
    ViewData["Title"] = "Editar Producto";
}

<h1 class="mb-4">Editar Producto</h1>

<div class="row">
    <div class="col-md-6">
        @* El Tag Helper asp-action="Edit" enviará los datos modificados de vuelta a una acción Edit en tu controlador *@
        <form asp-action="Edit" method="post">
            
            @* ¡MUY IMPORTANTE! Necesitamos enviar el ID a la base de datos para saber qué fila actualizar, pero el usuario no debe poder modificarlo visualmente. Por eso lo ocultamos. *@
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Nombre del Producto</label>
                <input asp-for="Name" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label">Precio</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" required />
            </div>
            
            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
@model IEnumerable<Firmeza.Web.Models.Product>
@{ ViewData["Title"] = "Productos"; }

<div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div><div class="page-eyebrow">Catálogo e inventario</div><h1>Productos</h1><p>Controla precios y existencias disponibles para la venta.</p></div>
    <div class="d-flex flex-wrap gap-2"><a asp-controller="Exports" asp-action="Excel" asp-route-tipo="productos" class="btn btn-outline-success">↓ Excel</a><a asp-controller="Exports" asp-action="Pdf" asp-route-tipo="productos" class="btn btn-outline-danger">↓ PDF</a><a asp-action="Create" class="btn btn-primary">＋ Nuevo producto</a></div>
</div>

<div class="card"><div class="table-responsive"><table class="table table-hover align-middle">
    <thead><tr><th>Producto</th><th>Precio</th><th>Existencias</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @if (!Model.Any())
    {
        <tr><td colspan="5" class="text-center py-5 text-muted">Aún no hay productos. Registra el primero para empezar.</td></tr>
    }
    else
    {
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@item.Name</strong>@if (!string.IsNullOrWhiteSpace(item.Description)) { <small class="d-block text-muted mt-1">@item.Description</small> }</td>
                <td>@item.Price.ToString("C")</td>
                <td><strong>@item.Stock</strong></td>
                <td>@if (item.Stock > 0) { <span class="badge" style="background:#e3f5f2;color:#0d817e">Disponible</span> } else { <span class="badge" style="background:#fff0ee;color:#d8443f">Sin existencias</span> }</td>
                <td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger ms-1">Eliminar</a></td>
            </tr>
        }
    }
    </tbody>
</table></div></div>

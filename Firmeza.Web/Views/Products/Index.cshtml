@model IEnumerable<Firmeza.Web.Models.Product>



@{
    // Esto cambia el título que aparece en la pestaña del navegador
    ViewData["Title"] = "Lista de Productos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4"><h1 class="mb-0">Catálogo de Productos</h1><div><a asp-controller="Exports" asp-action="Excel" asp-route-tipo="productos" class="btn btn-outline-success">Excel</a> <a asp-controller="Exports" asp-action="Pdf" asp-route-tipo="productos" class="btn btn-outline-danger">PDF</a> <a asp-action="Create" class="btn btn-primary">Nuevo producto</a></div></div>

@* Creamos la estructura básica de la tabla usando clases de Bootstrap *@
<table class="table table-striped table-bordered">
    <thead class="table-dark">
    <tr>
        <th>Nombre</th>
        <th>Precio</th>
        <th>Acciones</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Price</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                
            </td>
        </tr>
    }
    </tbody>
</table>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111827" />
    <title>@ViewData["Title"] · Firmeza</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        string Active(string controller, string? action = null) =>
            currentController == controller && (action is null || currentAction == action) ? "active" : string.Empty;
    }
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Firmeza, inicio">
                <span class="brand-mark">F<span>.</span></span>
                <span class="brand-copy"><strong>FIRMEZA</strong><small>FERRETERÍA · GESTIÓN</small></span>
            </a>

            <div class="sidebar-caption">MENÚ PRINCIPAL</div>
            <nav class="side-nav" aria-label="Navegación principal">
                <a class="side-link @Active("Home")" asp-controller="Home" asp-action="Index"><span class="nav-icon">⌂</span><span>Inicio</span></a>
                <a class="side-link @Active("Products")" asp-controller="Products" asp-action="Index"><span class="nav-icon">▦</span><span>Productos</span></a>
                <a class="side-link @Active("Customers")" asp-controller="Customers" asp-action="Index"><span class="nav-icon">♙</span><span>Clientes</span></a>
                <a class="side-link @Active("Sales")" asp-controller="Sales" asp-action="Index"><span class="nav-icon">↗</span><span>Ventas</span></a>
            </nav>

            <div class="sidebar-caption sidebar-caption-spaced">HERRAMIENTAS</div>
            <nav class="side-nav" aria-label="Herramientas">
                <a class="side-link @Active("Imports")" asp-controller="Imports" asp-action="Index"><span class="nav-icon">⇧</span><span>Importar Excel</span></a>
                <a class="side-link @Active("Exports")" asp-controller="Exports" asp-action="Index"><span class="nav-icon">⇩</span><span>Exportar información</span></a>
            </nav>

            <div class="sidebar-help">
                <span class="help-dot"></span>
                <div><strong>Todo en orden</strong><small>Tu negocio, bajo control</small></div>
            </div>
            <div class="sidebar-version">FIRMEZA <span>·</span> PANEL DE GESTIÓN</div>
        </aside>

        <div class="app-main">
            <header class="topbar">
                <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-controls="sidebar" aria-expanded="false">☰</button>
                <div class="topbar-context"><span class="context-kicker">FERRETERÍA FIRMEZA</span><span class="context-divider">/</span><span>@ViewData["Title"]</span></div>
                <div class="topbar-account">
                    <div class="account-avatar">@(User.Identity?.IsAuthenticated == true ? User.Identity.Name?.Substring(0, 1).ToUpperInvariant() : "F")</div>
                    <div class="account-copy"><strong>@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Panel de gestión")</strong><small>@(User.Identity?.IsAuthenticated == true ? "Sesión activa" : "Bienvenido")</small></div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="logout-button" title="Cerrar sesión" aria-label="Cerrar sesión">↪</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">Iniciar sesión</a>
                    }
                </div>
            </header>

            <main role="main" class="main-content">
                @RenderBody()
            </main>

            <footer class="admin-footer">
                <span>© @DateTime.Now.Year <strong>Firmeza</strong></span>
                <span>Herramientas, materiales y confianza para construir.</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

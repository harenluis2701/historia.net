<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Firmeza Dashboard</title>
    <!-- Mantiene los estilos de Bootstrap por defecto de .NET -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Llama a tu archivo site.css personalizado -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Barra superior oscura (Navbar) -->
    <header>
        <nav class="navbar navbar-dark bg-dark border-bottom border-secondary px-3">
            <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">FIRMEZA ADMIN</a>
            <div class="d-flex align-items-center">
                <span class="text-light me-3">Bienvenido, Administrador</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Cerrar Sesión</button>
                </form>
            </div>
        </nav>
    </header>

    <div class="wrapper">
        <!-- Menú Lateral (Sidebar) -->
        <aside class="sidebar pt-2">
            <ul class="list-unstyled mb-0">
                <li>
                    <a asp-controller="Home" asp-action="Index">📊 Inicio (Dashboard)</a>
                </li>
                <li>
                    <a asp-controller="Products" asp-action="Index">📦 Gestión de Productos</a>
                </li>
                <li>
                    <a asp-controller="Customers" asp-action="Index">👥 Gestión de Clientes</a>
                </li>
                <li>
                    <a href="#">💰 Registro de Ventas</a>
                </li>
            </ul>
        </aside>

        <!-- Contenedor Principal y Footer -->
        <div class="d-flex flex-column w-100">
            <main role="main" class="main-content">
                @RenderBody()
            </main>
            
            <!-- Pie de página (Footer) agregado para la Task 9 -->
            <footer class="admin-footer">
                &copy; @DateTime.Now.Year - Firmeza Dashboard. Todos los derechos reservados. | Desarrollado para la gestión de inventarios y clientes.
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>